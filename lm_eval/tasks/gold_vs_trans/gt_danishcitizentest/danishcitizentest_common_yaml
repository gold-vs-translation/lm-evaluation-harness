dataset_path: gold-vs-trans/danish-citizen-tests-dedup
output_type: multiple_choice

test_split: train
fewshot_split: train

doc_to_text: |
  Spørgsmål: {{question}}
  Svarmuligheder:
  A. {{option_a}}
  B. {{option_b}}{% if option_c is not none %}
  C. {{option_c}}{% endif %}

# We expand the options option_a .. option_c,
# option_c can be None
doc_to_choice: |-
  ["A", "B"{% if option_c is not none %}, "C"{% endif %}]

doc_to_target: "{{answer}}"

metric_list:
  - metric: acc
    aggregation: mean
    higher_is_better: true

metadata:
  description: "alexandrainst/danish-citizen-tests; MC, A-C, variable length"
  version: 1.0
